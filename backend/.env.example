# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=
DYNAMODB_TABLE_CASES=cases
DYNAMODB_TABLE_EVIDENCE=evidence

# Blockchain Configuration (Local)
# Default hardhat/ganache local URL
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# If using a deployed contract on testnet/local
BLOCKCHAIN_CONTRACT_ADDRESS=
# WARNING: Never commit production private keys to version control
# For local development, the default Hardhat test key is used
# For production, use AWS KMS or secure key management
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_ACCOUNT_ADDRESS=

# AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Security
# CRITICAL: Generate a strong random key for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=supersecretkeydefaultsfortestingonly
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
